# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.env

# Datos crudos (pesados / redescargables) — se versionan solo los .gitkeep
data/raw/*
!data/raw/.gitkeep

# Intermedios pesados de data/processed/ — solo se versiona la MATRIZ O-D final
# (od_matrix.parquet) para que el dashboard funcione offline.
data/processed/*.parquet
!data/processed/od_matrix.parquet
data/processed/*.graphml
data/processed/route_cache.sqlite
data/processed/*.sqlite-journal

# Logs
logs/*
!logs/.gitkeep

# Reportes de calidad: se versiona el resumen (.md y calidad_*.csv), no el
# detalle fila-a-fila (regenerable, puede pesar varios MB)
reports/quality/*_detalle.csv

# LaTeX (artefactos de compilación)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg

# Caché de osmnx / Overpass
cache/

# SO / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Zip para subir a Overleaf (regenerable)
report_overleaf.zip
